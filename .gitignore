# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Playwright
/test-results/
/playwright-report/

# Badge art candidates — every attempt plus its prompt sidecar and its crops.
# Source art (assets/badges/<key>.png) IS committed; attempts are not.
assets/badges/_candidates/

# Crops written by check_badge_art.py beside whatever it measured. Derived from
# a committed control, so committing them is noise.
assets/badges/_controls/*.themes.png
assets/badges/_controls/*.ring.png
assets/badges/_controls/*.centre.png

# F22's second deck, on exactly the same terms. Source art
# (assets/levels/<key>.png) and its .txt sidecar ARE committed — the sidecar
# carries the style version, and losing it makes a mixed deck undetectable.
assets/levels/_candidates/
assets/levels/_controls/*.themes.png
assets/levels/_controls/*.ring.png
assets/levels/_controls/*.centre.png

# Python bytecode from tools/. One .pyc was committed by accident before this
# line existed; it is untracked in the same commit.
__pycache__/

# Playwright's raw .webm, written by scripts/capture-media.ts and deleted by it
# on the way out. Listed for the run that crashes between the two.
/.media-tmp/
