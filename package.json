{
  "name": "daily-words",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.11.0"
  },
  "scripts": {
    "dev": "next dev --turbopack --port 3200",
    "build": "next build --turbopack",
    "start": "next start --port 3200",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:push": "drizzle-kit push",
    "llm:check": "tsx --conditions=react-server --env-file=.env.local scripts/check-llm.ts",
    "vocab:enrich": "tsx --conditions=react-server --env-file=.env.local scripts/enrich-once.ts",
    "dates:check": "tsx scripts/check-dates.ts",
    "nav:check": "tsx scripts/check-nav.ts",
    "selection:check": "tsx --conditions=react-server --env-file=.env.local scripts/check-selection.ts",
    "profile:check": "tsx scripts/check-profile.ts",
    "chat:check": "tsx scripts/check-chat.ts",
    "chat:db": "tsx --conditions=react-server --env-file=.env.local scripts/check-chat-db.ts",
    "chat:dry-run": "tsx --conditions=react-server --env-file=.env.local scripts/chat-dry-run.ts",
    "discover:check": "tsx scripts/check-discover.ts",
    "discover:db": "tsx --conditions=react-server --env-file=.env.local scripts/check-discover-db.ts",
    "discover:dry-run": "tsx --conditions=react-server --env-file=.env.local scripts/discover-dry-run.ts",
    "test:layout": "playwright test",
    "design:build": "node scripts/build-previews.mjs",
    "design:changed": "node scripts/dssync-changed.mjs",
    "journal:check": "tsx --conditions=react-server scripts/check-journal.ts",
    "journal:db": "tsx --conditions=react-server --env-file=.env.local scripts/check-journal-db.ts",
    "journal:dry-run": "tsx --conditions=react-server --env-file=.env.local scripts/journal-dry-run.ts",
    "badges:check": "tsx scripts/check-badge-art.ts",
    "stats:check": "tsx scripts/check-gamification.ts",
    "stats:db": "tsx --conditions=react-server --env-file=.env.local scripts/check-gamification-db.ts",
    "stats:recompute": "tsx --conditions=react-server --env-file=.env.local scripts/recompute-stats.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.116.0",
    "@auth/drizzle-adapter": "1.11.3",
    "clsx": "^2.1.1",
    "drizzle-orm": "0.45.2",
    "next": "15.5.23",
    "next-auth": "5.0.0-beta.32",
    "postgres": "3.4.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "server-only": "0.0.1",
    "tailwind-merge": "^3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17",
    "drizzle-kit": "0.31.10",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "tailwindcss": "^4",
    "tsx": "^4",
    "typescript": "^5"
  }
}
