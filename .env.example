# Copy to .env.local and fill in. .env.local is never committed.

# Neon Postgres. DATABASE_URL MUST be the POOLED host — the one with "-pooler" in it.
# Without the pooler, concurrent serverless invocations exhaust the connection limit.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The direct (non-pooled) host. Used only by drizzle-kit for migrations; DDL is
# happier on a real session than through PgBouncer. Optional — falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js v5. These exact names are read automatically by next-auth.
# AUTH_SECRET: `npx auth secret` or `openssl rand -base64 32`. Changing it logs everyone out.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LLM — GLM via z.ai, Anthropic Messages-API compatible.
# Do NOT put /v1 on the end of LLM_BASE_URL. The SDK appends /v1/messages itself.
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_MODEL=glm-4.6
LLM_API_KEY=
