# Copy to .env.local and fill in. .env.local is never committed.

# Neon Postgres. DATABASE_URL MUST be the POOLED host — the one with "-pooler" in it.
# Without the pooler, concurrent serverless invocations exhaust the connection limit.
DATABASE_URL=postgresql://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# The direct (non-pooled) host. Used only by drizzle-kit for migrations; DDL is
# happier on a real session than through PgBouncer. Optional — falls back to DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require

# Auth.js v5. These exact names are read automatically by next-auth.
# AUTH_SECRET: `npx auth secret` or `openssl rand -base64 32`. Changing it logs everyone out.
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# LLM — GLM via z.ai, Anthropic Messages-API compatible.
# Do NOT put /v1 on the end of LLM_BASE_URL. The SDK appends /v1/messages itself.
LLM_BASE_URL=https://api.z.ai/api/anthropic
LLM_MODEL=glm-4.6
LLM_API_KEY=

# F15 journal semantic dedup. ALL THREE ARE OPTIONAL: without a key the app
# boots, builds and saves normally — the normalised-hash layer needs no
# provider, and a missing key degrades the semantic layer to "not checked",
# never to a failed save. CI has no key.
#
# EMBEDDING_API_KEY is NOT the same variable as OPENAI_API_KEY, and should not
# hold the same secret. OPENAI_API_KEY belongs to the offline /generate-badge-art
# tooling and no application code may read it; this one is read at runtime by
# src/lib/llm/embed.ts. Use a separate OpenAI project key scoped to embeddings,
# so the two rotate independently. `npm run journal:check` asserts that
# OPENAI_API_KEY appears nowhere under src/.
#
# Note: journal text is sent to this provider. That is a deliberate decision
# ([S2a]) and the journal is the most personal content in the app.
EMBEDDING_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_KEY=
